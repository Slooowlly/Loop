    %% ── Entidades ───────────────────────────────────────────────────────────
    DRIVERS {
        TEXT id PK
        TEXT nome
        INTEGER is_jogador
        TEXT categoria_atual
        TEXT categoria_especial_ativa
        TEXT status
        TEXT personalidade_primaria
        TEXT personalidade_secundaria
        REAL skill
        REAL carisma
        REAL potencial
        REAL forma "v54: estado do AR(1)"
        REAL motivacao
        TEXT historico_circuitos "JSON"
        TEXT ultimos_resultados "JSON"
    }

    TEAMS {
        TEXT id PK
        TEXT nome
        TEXT nome_curto
        TEXT categoria
        TEXT categoria_anterior
        INTEGER is_player_team
        TEXT parent_team_id SEM
        TEXT piloto_1_id FK
        TEXT piloto_2_id FK
        TEXT hierarquia_n1_id SEM
        TEXT hierarquia_n2_id SEM
        INTEGER ativa
        REAL car_performance
        REAL confiabilidade
        REAL reputacao
        REAL cash_balance
        REAL debt_balance
        TEXT financial_state
        TEXT season_strategy
    }

    CONTRACTS {
        TEXT id PK
        TEXT piloto_id FK
        TEXT equipe_id FK
        TEXT categoria
        TEXT classe "so em contrato especial"
        TEXT tipo "Regular ou Especial"
        TEXT status
        TEXT papel "Numero1 ou Numero2"
        REAL salario_anual
        INTEGER duracao_anos
    }

    SEASONS {
        TEXT id PK
        INTEGER numero
        INTEGER ano
        TEXT status "EmAndamento ou Finalizada"
        TEXT fase "PreTemporada, Temporada, Encerramento"
        INTEGER rodada_atual
    }

    CALENDAR {
        TEXT id PK
        TEXT temporada_id FK
        TEXT categoria
        INTEGER rodada
        TEXT track_name
        TEXT clima
        INTEGER voltas
        INTEGER duracao_corrida_min "0 = sentinela de endurance"
        TEXT status "Pendente ou Concluida"
        INTEGER week_of_year
        INTEGER season_week "woy + 4"
        TEXT season_phase
        TEXT thematic_slot
    }

    RACE_RESULTS {
        TEXT id PK
        TEXT race_id FK "referencia calendar(id)"
        TEXT piloto_id FK
        TEXT equipe_id FK
        INTEGER posicao
        REAL pontos
        INTEGER dnf
        INTEGER incidentes
        INTEGER segmentos_em_ar_sujo "v55"
        INTEGER maior_sequencia_preso "v55"
        TEXT posicao_por_trecho "v55, JSON"
        TEXT paradas "v55, JSON"
    }

    RACES {
        TEXT id PK
        TEXT temporada_id FK
        TEXT calendar_id FK
        TEXT status "LEGADA: sem leitura viva"
    }

    STANDINGS {
        TEXT temporada_id FK
        TEXT piloto_id FK
        TEXT equipe_id FK
        TEXT categoria
        REAL pontos
        INTEGER posicao
    }

    RACE_BREAKDOWNS {
        TEXT race_id FK
        TEXT piloto_id SEM
        TEXT part_type
        REAL tempo_perdido_ms
    }

    RACE_WEEKEND_READINGS {
        TEXT race_id PK
        TEXT driver_id PK
    }

    PLAYER_RACE_TELEMETRY {
        TEXT race_id PK
    }

    TEAM_CAR {
        TEXT team_id PK
        TEXT part_type PK
        REAL wear
        INTEGER unit_seed "v62"
    }

    RIVALRIES {
        TEXT id PK
        TEXT piloto1_id FK
        TEXT piloto2_id FK
        REAL historical_intensity
        REAL recent_activity
        INTEGER temporada_update
    }

    MARKET_PROPOSALS {
        TEXT id PK
        TEXT temporada_id FK
        TEXT equipe_id FK
        TEXT piloto_id FK
        TEXT papel
        REAL salario
        TEXT status
        TEXT motivo_recusa
        INTEGER semana_limite
    }

    PLAYER_SPECIAL_OFFERS {
        TEXT id PK
        TEXT season_id FK
        TEXT player_driver_id FK
        TEXT team_id FK
        TEXT special_category
        TEXT class_name
        INTEGER available_from_day
        INTEGER resolved_day
    }

    NEWS {
        TEXT id PK
        TEXT tipo
        TEXT titulo
        TEXT chave_dedup "indice unico"
        TEXT temporada_id FK
        INTEGER rodada
        INTEGER lida
    }

    DRIVER_SEASON_ARCHIVE {
        TEXT piloto_id SEM
        INTEGER season_number
        TEXT snapshot "atributos ao fim da temporada"
    }

    HISTORY_SEASONS {
        INTEGER id PK
        TEXT temporada_id SEM
        INTEGER ano
        TEXT categoria
        TEXT campeao_piloto_id SEM
        TEXT campeao_equipe_id SEM
        TEXT classificacao_final "JSON"
    }
