{
  "productName": "Loop",
  "version": "0.13.1",
  "identifier": "com.loop.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Loop",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": true,
        "maximized": false,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "Loop Overlay",
        "url": "index.html",
        "width": 512,
        "height": 1024,
        "x": 12,
        "y": 12,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "engineer",
        "title": "Loop Engineer",
        "url": "index.html",
        "width": 620,
        "height": 200,
        "x": 653,
        "y": 195,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://storage.googleapis.com/loop-updates/updates/{{target}}/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMEI3NzRFOTNEOEVEQUYKUldTdjdkaVRUbmNMSUxUU25iUko4MHpzWEl5bVk5eERMa2NNaVNaOUJkemxUaWZtbUFadHNRVHkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon-installer.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
